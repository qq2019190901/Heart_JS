{
  "name": "heart-js",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build",
    "build:electron": "npm run build && npm run prep-staging && electron-builder --dir",
    "dist:electron": "npm run build && npm run prep-staging && electron-builder",
    "prep-staging": "rm -rf _staging && mkdir _staging && cp dist-electron/main.js _staging/ && cp -r dist _staging/ && cp server.cjs _staging/ && cp package.json _staging/",
    "preview": "vite preview",
    "test": "vitest run",
    "lan-server": "node server.cjs"
  },
  "build": {
    "appId": "com.heartjs.game",
    "productName": "Heart JS",
    "directories": {
      "output": "_build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "server.cjs"
    ],
    "win": {
      "target": "dir",
      "icon": "public/favicon.svg"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "server.cjs"
    ],
    "extraFiles": [
      {
        "from": "server.cjs",
        "to": "resources/app.asar.unpacked/server.cjs"
      }
    ]
  }
}
