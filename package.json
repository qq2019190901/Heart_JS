{
  "name": "heart-js",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json && vite build",
    "build:electron": "npm run build && npm run prep-staging && electron-builder --dir",
    "dist:electron": "node scripts/update-version.js && npm run build && npm run prep-staging && electron-builder",
    "build:electron": "npm run build && npm run prep-staging && electron-builder --dir",
    "prep-staging": "rm -rf _staging && mkdir _staging && cp dist-electron/main.js _staging/ && cp -r dist _staging/ && cp package.json _staging/",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/vite": "^4.3.1",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "framer-motion": "^12.40.0",
    "http-errors": "^2.0.1",
    "mime-types": "^3.0.2",
    "on-finished": "^2.4.1",
    "peer": "^1.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "send": "^1.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "peerjs": "^1.5.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.heartjs.game",
    "productName": "Heart JS",
    "directories": {
      "output": "_build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "public/favicon.svg"
    },
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "dist-electron/preload.js",
      "dist-electron/main.js",
      "dist-electron/peer-server.js"
    ]
  }
}
